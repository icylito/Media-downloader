{
  "name": "media-downloader",
  "version": "1.1.0",
  "description": "YouTube video & audio downloader (MP4 up to 4K, MP3/FLAC/Opus)",
  "author": "Icy",
  "license": "MIT",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.icy.mediadownloader",
    "productName": "Media downloader",
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "binaries/",
        "filter": [
          "**/*.exe"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MediaDownloader-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "MediaDownloader-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "ws": "^8.22.0"
  }
}
